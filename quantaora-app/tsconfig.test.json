{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@content/*": ["../content/*"]
    },
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode, matching tsconfig.app.json — these files import plain
       .ts modules under src/ (e.g. modelRegistry.ts) that themselves use
       extensionless relative imports written for bundler resolution;
       "nodenext" would force every transitively-checked file in src/ to add
       explicit extensions just to satisfy this narrow test project. Node
       still runs *.test.ts fine under this setting (`node --test` uses its
       own native ESM loader + type-stripping, independent of this
       type-checking-only config). */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts"]
}
